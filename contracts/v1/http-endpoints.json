    "shape": "flat",
    "metadata": {
      "$ref": "schemas/boundary.schema.json#/$defs/responseMetadata"
    },
    "validation": "HTTP success body merges the response payload and requestId/version metadata, matching existing respond(). Validate metadata first, strip exactly those two keys, then validate the remaining object using the endpoint response ref."
  }
