{
  "name": "frontline-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/local-dev.mjs",
    "dev:server": "node scripts/require-research-config.mjs && vite --host 127.0.0.1",
    "dev:integrations": "node scripts/local-dev.mjs --integrations",
    "dev:postgres-worker": "node scripts/local-dev.mjs --postgres-worker",
    "check:research-config": "node scripts/require-research-config.mjs",
    "check:local-research-runtime": "node scripts/checks/local-research-runtime.mjs && node scripts/checks/local-research-readiness-smoke.mjs",
    "start": "node server/production-server.js",
    "build": "vite build && node scripts/prerender-landing.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-browser-tooling.mjs && vitest run",
    "test:post-onboarding": "vitest run --config vitest.post-onboarding.config.mjs",
    "check:browser-tooling": "node scripts/check-browser-tooling.mjs",
    "check:contracts": "node --test tests/contracts-node-check.mjs && python3 contracts/v1/python/test_frontline_contracts.py",
    "migrate:dry-run": "node scripts/migrate.mjs --dry-run"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@vitejs/plugin-react": "5.0.4",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "9.36.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "vitest": "^4.1.11"
  }
}
