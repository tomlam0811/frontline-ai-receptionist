FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
WORKDIR /app
COPY workers/voice/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 frontline
COPY --chown=frontline:frontline contracts ./contracts
COPY --chown=frontline:frontline workers/voice ./workers/voice
USER frontline
CMD ["python", "workers/voice/agent.py", "start"]
